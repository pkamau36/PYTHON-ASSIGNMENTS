
# Assignment: Data Analysis with Pandas & Matplotlib (Shop Sales Data)


import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


%matplotlib inline
sns.set(style="whitegrid")

# ------------------------------
# Task 1: Load and Explore Dataset
# ------------------------------

try:
    # Load dataset from CSV
    df = pd.read_csv("sales.csv")

    print("First 5 rows of dataset:")
    display(df.head())

    print("\nDataset info:")
    print(df.info())

    print("\nMissing values:")
    print(df.isnull().sum())

    # Clean dataset: drop rows with missing values (if any)
    df.dropna(inplace=True)

except FileNotFoundError:
    print("❌ sales.csv not found! Please place the dataset in the same folder as this script.")

# ------------------------------
# Task 2: Basic Data Analysis
# ------------------------------

# Summary statistics of numerical columns
print("\nSummary statistics:")
display(df.describe())

# Compute total sales amount = Quantity × Price
df["Total_Sales"] = df["Quantity"] * df["Price"]

# Grouping: average sales per product
avg_sales = df.groupby("Product")["Total_Sales"].mean()
print("\nAverage sales per product:")
print(avg_sales)

# ------------------------------
# Task 3: Visualizations
# ------------------------------

# 1. Line chart: total sales trend over time
plt.figure(figsize=(8,5))
daily_sales = df.groupby("Date")["Total_Sales"].sum()
plt.plot(daily_sales.index, daily_sales.values, marker="o")
plt.title("Daily Total Sales Trend")
plt.xlabel("Date")
plt.ylabel("Total Sales ($)")
plt.xticks(rotation=45)
plt.show()

# 2. Bar chart: average sales per product
plt.figure(figsize=(6,5))
avg_sales.plot(kind="bar", color=["#66c2a5", "#fc8d62", "#8da0cb"])
plt.title("Average Sales per Product")
plt.xlabel("Product")
plt.ylabel("Average Sales ($)")
plt.show()

# 3. Histogram: distribution of quantity sold
plt.figure(figsize=(6,5))
plt.hist(df["Quantity"], bins=10, edgecolor="black")
plt.title("Distribution of Quantity Sold")
plt.xlabel("Quantity")
plt.ylabel("Frequency")
plt.show()

# 4. Scatter plot: Quantity vs Total Sales
plt.figure(figsize=(6,5))
sns.scatterplot(x="Quantity", y="Total_Sales", hue="Product", data=df, palette="Set1")
plt.title("Quantity vs Total Sales by Product")
plt.xlabel("Quantity")
plt.ylabel("Total Sales ($)")
plt.legend(title="Product")
plt.show()

# ------------------------------
# Task 4: Findings / Observations
# ------------------------------

# - The dataset contains daily sales of fruits (Apples, Bananas, Oranges).
# - No missing values were found after cleaning.
# - Apples generate the highest average sales, while Bananas are the lowest.
# - Daily sales trend shows growth in Oranges over time.
# - Histogram shows that most sales quantities are between 15–35 units.
# - Scatter plot confirms that higher quantity generally results in higher sales.

